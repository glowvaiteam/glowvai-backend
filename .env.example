# ==============================================================================
# GlowVAI V2 — Production Environment Variables Template
# Copy this file to .env and configure real credentials.
# NEVER commit .env with real secrets to public version control!
# ==============================================================================

# --- Firebase Client Configuration (Mobile App / Web) ---
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Firebase Local Emulator Flags (Optional) ---
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2

# --- Google Maps Platform ---
# Client-side (restricted by Android package: com.glowvai.app)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-side (used in backend/main.py for secure geocoding proxy)
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here

# --- Render Cloud CNN & Backend URL ---
EXPO_PUBLIC_RENDER_API_URL=https://glowvai-backend-r7u2.onrender.com

# --- Cashfree Payments Gateway (Backend Server Secrets) ---
# Set CASHFREE_ENVIRONMENT to 'sandbox' for testing, 'production' for live payments
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=TEST1029384756
CASHFREE_SECRET_KEY=cfsk_ma_test_d717ac6fa0c5ab0b1c9d0c144aa7b1c5_2b5bc8c8
CASHFREE_API_VERSION=2023-08-01

# --- Firebase Admin SDK (Backend Server) ---
# FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./service-account.json
