# ==============================================================================
# GlowVAI V2 — Environment Variables Template
# Copy this file to .env and fill in the required values.
# NEVER commit .env to Git or expose any secret keys!
# ==============================================================================

# --- Firebase Client Configuration (Mobile App / Web) ---
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Firebase Local Emulator Flags ---
# Set to 'true' during local offline development with Firebase Emulators
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2 # Android emulator localhost alias

# --- Google Maps Platform ---
# Restrict this key to Android apps (SHA-1 + com.glowvai.app) in Google Cloud Console
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Payment Gateway (Public Key only - Client Side) ---
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# --- Server-Side Secret Environment Variables (Firebase Cloud Functions ONLY) ---
# DO NOT PREFIX WITH EXPO_PUBLIC_
# RAZORPAY_KEY_SECRET=your_server_side_secret_here
# FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./service-account.json
