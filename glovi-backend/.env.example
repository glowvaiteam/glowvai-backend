# ==============================================================================
# GloVi Express Backend — Production Environment Variables
# Copy this file to .env and configure your real credentials.
# NEVER commit your .env file with real secrets to GitHub!
# ==============================================================================

# --- Server Port ---
PORT=5000

# --- Cashfree Payments Gateway ---
# Set to 'SANDBOX' for testing, 'PRODUCTION' for live INR transactions
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_APP_ID=TEST1029384756
CASHFREE_SECRET_KEY=cfsk_ma_test_d717ac6fa0c5ab0b1c9d0c144aa7b1c5_2b5bc8c8
CASHFREE_API_VERSION=2023-08-01

# --- Google Maps Platform (Server-Side Only) ---
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key_here

# --- PyTorch CNN Model Inference Backend ---
CNN_SERVICE_URL=https://glowvai-backend-r7u2.onrender.com/predict

# --- Firebase Admin SDK (Choose Option A or Option B) ---
# Option A: Path to downloaded Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Raw JSON string or Project ID fallback
FIREBASE_PROJECT_ID=glowvai-v2
